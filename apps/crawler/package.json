    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "joi": "^18.2.9",
    "node-html-parser": "^9.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
