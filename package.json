{
  "name": "everyone-house",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "oxlint apps packages",
    "format": "prettier --write \"{apps,packages}/*/src/**/*.ts\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "migration:generate": "npm run migration:generate -w @everyone-house/db",
    "migration:run": "npm run migration:run -w @everyone-house/db",
    "migration:revert": "npm run migration:revert -w @everyone-house/db",
    "lint:fix": "oxlint --fix apps packages",
    "typecheck": "tsc -p packages/domain/tsconfig.test.json && tsc -p packages/db/tsconfig.test.json && tsc -p apps/crawler/tsconfig.test.json"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.4",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "jest": "^30.5.2",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  }
}
