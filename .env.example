# ─── 로컬 개발 DB (docker compose up -d postgres) ───
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/everyone_house
# 통합 테스트용 (개발 DB 를 지우므로 반드시 분리한다)
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/everyone_house_test

# ─── 마이홈포털 모집공고 API 인증키 ───
# data.go.kr 에서 "국토교통부_마이홈포털 공공주택 모집공고 조회 서비스" 활용신청 후
# 마이페이지 > 오픈API > 개발계정에서 일반 인증키(Encoding) 발급
MYHOME_SERVICE_KEY=

# ─── 공고문 분석 (Claude API) ───
ANTHROPIC_API_KEY=

# ─── 수집 대상 엔드포인트 ───
# 공개 저장소에 수집 경로를 남기지 않기 위해 코드가 아닌 환경변수로 받는다.
# 실제 값은 로컬 docs/sources.local.md 참고 (git 에 올라가지 않음).
SH_LIST_URL=
SH_BASE_URL=
SH_DETAIL_URL_PREFIX=
MYHOME_API_URL=
MYHOME_DETAIL_URL_PREFIX=
MYHOME_DOWNLOAD_URL=
GH_LIST_URL=
GH_DETAIL_URL=

# ─── 알림 (텔레그램) — 미구현 ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
